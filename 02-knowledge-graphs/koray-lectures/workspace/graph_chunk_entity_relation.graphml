  <data key="d4">unknown_source</data>
  <data key="d5">1779791788</data>
  <data key="d6"></data>
</node>
<node id="Context Scoring">
  <data key="d0">Context Scoring</data>
  <data key="d1">method</data>
  <data key="d2">Context Scoring is the process of assigning relevance scores to content based on contextual factors.</data>
  <data key="d3">chunk-601527952de3e4cb533d4928c1d0ad26</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791788</data>
