<node id="Web Story">
  <data key="d0">Web Story</data>
  <data key="d1">concept</data>
  <data key="d2">Web Story is a type of content format, and the Quarice Framework is used for web stories, including e-commerce cases.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791658</data>
