  <data key="d0">Search Query Terms</data>
  <data key="d1">data</data>
  <data key="d2">Search Query Terms are the initial input from which questions are generated in the Quarice Framework.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791657</data>
  <data key="d6"></data>
</node>
<node id="Questions">
  <data key="d0">Questions</data>
  <data key="d1">concept</data>
  <data key="d2">Questions are generated from search query terms and are prioritized, given a hierarchy, and structured.&lt;SEP&gt;Various types of questions that answer terms help to answer.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036&lt;SEP&gt;chunk-eef1d53ea2fafdb6002975ead6658b03</data>
  <data key="d4">unknown_source</data>
