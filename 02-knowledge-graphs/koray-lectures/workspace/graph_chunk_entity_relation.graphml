  <data key="d0">Explored But Not Crawled</data>
  <data key="d1">concept</data>
  <data key="d2">A status in Google Search Console indicating that a URL was seen but not crawled by the search engine.</data>
  <data key="d3">chunk-84be65ef542a67b8c7039f750beecb23</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779790869</data>
