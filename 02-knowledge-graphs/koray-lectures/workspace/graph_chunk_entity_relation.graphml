<node id="Image Design">
  <data key="d0">Image Design</data>
  <data key="d1">concept</data>
  <data key="d2">Image Design is a visual element specified by the Contextual Structure, including the image alt tag.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791658</data>
  <data key="d6"></data>
</node>
<node id="Image Alt Tag">
  <data key="d0">Image Alt Tag</data>
  <data key="d1">concept</data>
  <data key="d2">Image Alt Tag is a text alternative for images, specified as part of the image design in the Contextual Structure.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791658</data>
