  <data key="d6"></data>
</node>
<node id="Obstructive Summary">
  <data key="d0">Obstructive Summary</data>
  <data key="d1">method</data>
  <data key="d2">A summary that fails if the article has broken points in contextual flow; likely refers to abstractive summarization.&lt;SEP&gt;Obstructive summary is another method of creating summaries.</data>
  <data key="d3">chunk-6aa4f955c977e4411acda6af90a1e984&lt;SEP&gt;chunk-8122ad3e878784e98cdd0c33cb998553</data>
  <data key="d4">unknown_source</data>
