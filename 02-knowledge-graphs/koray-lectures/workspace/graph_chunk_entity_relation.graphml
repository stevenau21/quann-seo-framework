  <data key="d0">Old Europe Section</data>
  <data key="d1">concept</data>
  <data key="d2">The Old Europe Section is a part of the internal link structure that links back to older countries from the Europe root article.</data>
  <data key="d3">chunk-043bc92a7015e647914eacacd758a036</data>
