<node id="Long Form Mentioning Answer">
  <data key="d0">Long Form Mentioning Answer</data>
  <data key="d1">concept</data>
  <data key="d2">A comprehensive answer that includes all qualifiers, signifiers, concepts, and connections of an entity.</data>
