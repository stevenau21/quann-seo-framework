  <data key="d6"></data>
</node>
<node id="Video">
  <data key="d0">Video</data>
  <data key="d1">content</data>
  <data key="d2">The video is a suggested resource to watch for understanding entity attribute and value triples.&lt;SEP&gt;A video that shows signs of water intoxication.</data>
