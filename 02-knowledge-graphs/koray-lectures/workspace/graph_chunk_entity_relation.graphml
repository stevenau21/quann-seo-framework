  <data key="d1">artifact</data>
  <data key="d2">A tool by Google that provides data on how URLs are explored and crawled, including the "explored but not crawled" status.</data>
  <data key="d3">chunk-84be65ef542a67b8c7039f750beecb23</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779790869</data>
  <data key="d6"></data>
</node>
