<node id="Contextual Crawl Path">
  <data key="d0">Contextual Crawl Path</data>
  <data key="d1">concept</data>
  <data key="d2">A logical path created by URL structure and internal linking that helps search engines understand the context and crawl pages efficiently.</data>
  <data key="d3">chunk-84be65ef542a67b8c7039f750beecb23</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779790869</data>
  <data key="d6"></data>
</node>
<node id="Root">
  <data key="d0">Root</data>
  <data key="d1">concept</data>
  <data key="d2">The top layer in the semantic content network, to which all other pages connect, and which links to the homepage.&lt;SEP&gt;Root refers to the primary article or page that is the target of internal links from supplementary content.</data>
  <data key="d3">chunk-84be65ef542a67b8c7039f750beecb23&lt;SEP&gt;chunk-c10223fd9ea5d44bdbd29c6221184f67</data>
