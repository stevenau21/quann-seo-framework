  <data key="d1">concept</data>
  <data key="d2">The arrangement and hierarchy of URLs, which the instructor discusses as important for search engine crawling and topical relevance.</data>
  <data key="d3">chunk-84be65ef542a67b8c7039f750beecb23</data>
  <data key="d4">unknown_source</data>
