</node>
<node id="Search Behavior Model">
  <data key="d0">Search Behavior Model</data>
  <data key="d1">concept</data>
  <data key="d2">A Search Behavior Model is used by search engines to understand possible and relative search behaviors.</data>
  <data key="d3">chunk-601527952de3e4cb533d4928c1d0ad26</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779791787</data>
