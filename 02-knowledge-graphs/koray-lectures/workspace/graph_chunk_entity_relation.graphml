  <data key="d1">concept</data>
  <data key="d2">Broken points are issues in the article that prevent the creation of a proper abstractive summary.</data>
  <data key="d3">chunk-bbac222e7b9f4ed501578b6503d7e819</data>
  <data key="d4">unknown_source</data>
