# =============================================================================
# LightRAG Nexus Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# WARNING: .env is gitignored — never commit real credentials.

# ── Nexus Servers (thin configs, shared engine) ──

# quann-chat (port 8001)
QUANN_CHAT_LLM_MODEL=gemma4:31b-cloud
QUANN_CHAT_EMBED_MODEL=nomic-embed-text-v2-moe
QUANN_CHAT_EMBED_DIM=768

# seo-methodology (port 8002)
SEO_LLM_MODEL=deepseek-v4-pro:cloud
SEO_EMBED_MODEL=nomic-embed-text-v2-moe
SEO_EMBED_DIM=768

# ── LightRAG Built-in Web UI (lightrag-server CLI, port 8010) ──
# Uncomment and configure to launch the production web dashboard.
# The UI reads the SAME workspace as the Nexus server — no duplicate indexing.
#
# WEBUI_WORKING_DIR=/home/steve/lightrag-apps/quann-chat/workspace
# WEBUI_HOST=0.0.0.0
# WEBUI_PORT=8010
# WEBUI_LLM_MODEL=gemma4:31b-cloud
# WEBUI_EMBED_MODEL=nomic-embed-text-v2-moe
# WEBUI_EMBED_DIM=768
# WEBUI_TITLE=Quann Chat
# WEBUI_DESCRIPTION=Production knowledge graph RAG

# ── Ollama Connection ──
# Windows host Ollama (WSL2 virtual switch, typically 192.168.4.148)
# or cloud endpoint (https://ollama.com/v1 with OLLAMA_API_KEY)
OLLAMA_HOST=http://192.168.4.148:11434

# Ollama Cloud API key (only needed if using https://ollama.com/v1)
# Get from: https://ollama.com/settings/api-keys
# OLLAMA_API_KEY=***

# ── Reranker (CPU-only, shared across all bots) ──
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1

# ── CORS (allowed origins for the chat widget) ──
CORS_ORIGINS=https://quann.homes,https://quanbot.quann.homes
